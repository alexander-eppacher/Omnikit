# Kopieren nach „.env“ und ausfüllen. Die .env-Datei nie ins Repo (steht in .gitignore).

# Name, unter dem der Server erreichbar ist (DNS-Name oder IP im LAN)
OMNIKIT_DOMAIN=omnikit.local
# „internal“ = eigenes Zertifikat fürs LAN, sonst eine E-Mail-Adresse für Let's Encrypt
OMNIKIT_TLS=internal
# Passwort des ersten Admins (Benutzer „admin“), mindestens 12 Zeichen; gilt nur beim allerersten Start
OMNIKIT_ADMIN_PASSWORD=
# Passwort der Datenbank (beliebig lang und zufällig)
POSTGRES_PASSWORD=
# Zeitzone für die Anzeige
TZ=Europe/Berlin
