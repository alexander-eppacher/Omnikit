<Project>
  <!-- Gemeinsame Einstellungen für alle Projekte der Solution -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Abnahmekriterium "baut ohne Warnungen": jede Warnung bricht den Build ab -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>Alexander Eppacher</Authors>
    <Copyright>Copyright (c) 2026 Alexander Eppacher</Copyright>

    <!-- Eine Versionsnummer für App, Hilfsprozess, Agent und Server. Ein Release setzt VersionSuffix leer
         (dotnet build -p:VersionSuffix=), Entwicklungsstände heißen „4.0.0-dev“. -->
    <VersionPrefix>4.0.3</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>

    <!-- Nachvollziehbare Builds: gleiche Quellen ergeben gleiche Dateien (Paketversionen sind in den .csproj exakt festgelegt) -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
