<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kern: Modul-Schnittstelle, Systemerkennung, Einstellungen. Keine UI-Abhängigkeiten. -->

  <ItemGroup>
    <!-- ILogger-Schnittstelle, damit der Kern loggen kann, ohne Serilog zu kennen -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- WMI-Abfragen; funktioniert nur unter Windows -->
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <NeutralLanguage>de</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Texte: aus CoreTexts.resx wird beim Bauen die Klasse Omnikit.Core.Resources.CoreTexts erzeugt -->
    <EmbeddedResource Update="Resources\CoreTexts.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)CoreTexts.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Omnikit.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>CoreTexts</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Omnikit.Core.Tests" />
  </ItemGroup>
</Project>
