<Project Sdk="Microsoft.NET.Sdk">
  <!-- Leistung: Live-Auslastung von CPU, RAM, Laufwerken, Netzwerk und Grafik. Nur lesen, nur solange die Seite offen ist. -->

  <PropertyGroup>
    <NeutralLanguage>de</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcTool.Core\PcTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Texte: aus PerformanceTexts.resx wird beim Bauen die Klasse PcTool.Modules.Performance.Resources.PerformanceTexts erzeugt -->
    <EmbeddedResource Update="Resources\PerformanceTexts.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)PerformanceTexts.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PcTool.Modules.Performance.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>PerformanceTexts</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcTool.Modules.Performance.Tests" />
  </ItemGroup>
</Project>
