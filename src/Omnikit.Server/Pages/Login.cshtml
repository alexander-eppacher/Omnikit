@page
@model LoginModel
@{
    ViewData["Title"] = ServerTexts.Login_Title;
}
<h1>Omnikit Server</h1>
<form method="post" class="card" style="max-width: 360px">
    <p><label>@ServerTexts.Label_UserName<br /><input asp-for="UserName" autocomplete="username" required /></label></p>
    <p><label>@ServerTexts.Label_Password<br /><input asp-for="Password" type="password" autocomplete="current-password" required /></label></p>
    @if (Model.Error is not null)
    {
        <p class="error">@Model.Error</p>
    }
    <button type="submit" class="primary">@ServerTexts.Login_Button</button>
</form>
