<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Server: Schnittstelle für die Agents und Verwaltungsseiten (Razor Pages). Läuft in Docker hinter Caddy (HTTPS). -->

  <PropertyGroup>
    <NeutralLanguage>de</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omnikit.Shared\Omnikit.Shared.csproj" />
    <!-- Programmkatalog und Prüfung der Paket-IDs, dieselben wie in der App -->
    <ProjectReference Include="..\Omnikit.Modules.Apps\Omnikit.Modules.Apps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Datenbank: SQLite-Datei (MIT, von Microsoft) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Nur zum Erzeugen von Migrationen (dotnet ef, MIT, von Microsoft); landet nicht im fertigen Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Texte: aus ServerTexts.resx wird beim Bauen die Klasse Omnikit.Server.Resources.ServerTexts erzeugt -->
    <EmbeddedResource Update="Resources\ServerTexts.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)ServerTexts.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Omnikit.Server.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ServerTexts</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Omnikit.Server.Tests" />
  </ItemGroup>
</Project>
