<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Omnikit.Desktop.ViewModels"
        xmlns:res="using:Omnikit.Desktop.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="Omnikit.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static res:Strings.App_Title}"
        Width="960" Height="600" MinWidth="640" MinHeight="400">

    <Grid ColumnDefinitions="220,*">

        <!-- Navigationsleiste links -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0"
                Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{x:Static res:Strings.App_Title}"
                           FontSize="20" FontWeight="SemiBold"
                           Margin="12,8,12,16" />

                <!-- Update-Prüfung ein/aus (höchstens einmal am Tag, ohne Kennung) -->
                <CheckBox DockPanel.Dock="Bottom" Margin="12,0,12,4" IsChecked="{Binding Update.CheckForUpdates}"
                          ToolTip.Tip="{x:Static res:Strings.Update_CheckTooltip}">
                    <TextBlock Text="{x:Static res:Strings.Update_CheckLabel}" Opacity="0.7" TextWrapping="Wrap" />
                </CheckBox>

                <!-- Schalter "Einfach / Experte" für die ganze App -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8" Spacing="2"
                            ToolTip.Tip="{x:Static res:Strings.ViewMode_Tooltip}">
                    <TextBlock Text="{x:Static res:Strings.ViewMode_Label}" Opacity="0.7" />
                    <ToggleSwitch IsChecked="{Binding ViewMode.IsExpert}"
                                  OnContent="{x:Static res:Strings.ViewMode_Expert}"
                                  OffContent="{x:Static res:Strings.ViewMode_Simple}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Inhalt rechts: die ausgewählte Seite. Welche View zu welchem ViewModel gehört, entscheidet der ViewLocator. -->
        <DockPanel Grid.Column="1" Margin="24">
            <!-- Neue Version verfügbar -->
            <Border DockPanel.Dock="Top" IsVisible="{Binding Update.HasOffer}" Margin="0,0,0,16" Padding="12,8" CornerRadius="4"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                <StackPanel Spacing="4">
                    <WrapPanel>
                        <TextBlock Text="{Binding Update.OfferText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{Binding Update.InstallButtonText}" Command="{Binding Update.InstallCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Update.Status}" TextWrapping="Wrap"
                               IsVisible="{Binding Update.Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>

            <Panel>
                <TextBlock IsVisible="{Binding IsLoading}"
                           Text="{x:Static res:Strings.Main_Loading}" />
                <TextBlock IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
                <ContentControl Content="{Binding SelectedItem.Page}" />
            </Panel>
        </DockPanel>
    </Grid>
</Window>
