<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Omnikit.Desktop.Resources"
        x:Class="Omnikit.Desktop.Views.ConfirmationDialog"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="20">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <!-- Lange Texte (z. B. viele Programme) bekommen einen Rollbalken, statt das Fenster über den Bildschirm wachsen zu lassen -->
        <ScrollViewer MaxHeight="380">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="22" />
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="{x:Static res:Strings.Dialog_Cancel}" IsCancel="True" Click="OnCancel" />
            <Button x:Name="ContinueButton" Content="{x:Static res:Strings.Dialog_Continue}" IsDefault="True" Click="OnContinue"
                    Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
